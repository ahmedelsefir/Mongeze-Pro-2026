# Preferred Supabase connection settings.
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_ANON_KEY=

# Legacy names remain supported when the preferred variables are unset.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server/database credentials; never expose service-role secrets in client code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Required only for the Telegram polling bot.
TELEGRAM_TOKEN=

# Recommended: comma-separated numeric Telegram user IDs for owner-only features.
OWNER_TELEGRAM_IDS=

# Do not commit real tokens or private credentials.
